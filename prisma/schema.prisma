// Prisma Schema for Customer Management System
generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 客户模型
model Customer {
  id              String   @id @default(cuid())
  // 基本信息
  companyName     String   @map("company_name") // 公司名称
  enterpriseScale String?  @map("enterprise_scale") // 企业规模
  country         String?  @map("country") // 国家
  establishDate   DateTime? @map("establish_date") // 成立日期
  address         String?  @map("address") // 地址
  regCapital      String?  @map("reg_capital") // 注册资本
  industry        String?  @map("industry") // 公司行业
  employeeCount   String?  @map("employee_count") // 员工人数
  notes           String?  @map("notes") // 备注信息
  level           String?  @default("C") @map("level") // 客户等级 A,B,C,D,E
  
  // 联系方式
  phone           String?  @map("phone") // 电话
  fax             String?  @map("fax") // 传真
  website         String?  @map("website") // 网址
  email           String?  @unique @map("email") // 邮箱
  socialMedia     String?  @map("social_media") // 社媒
  contactAddress  String?  @map("contact_address") // 联系地址
  
  // 关键联系人
  keyContactId    String?  @map("key_contact_id") // 关键联系人ID
  keyContact      Contact? @relation("KeyContact", fields: [keyContactId], references: [id], onDelete: SetNull)
  
  userId          String?  @map("user_id") // 归属用户
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  status          String   @default("active") @map("status")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  
  orders          Order[]
  files           File[]   @relation("CustomerFiles")
  contacts        Contact[] // 关联联系人
  followUps       FollowUp[] // 关联跟进记录
  scripts         FollowUpScript[] // 关联跟进话术
  needs           CustomerNeed[] // 关联需求分析
  
  @@index([userId])
  @@map("customers")
}

// 客户需求分析模型
model CustomerNeed {
  id            String   @id @default(cuid())
  customerId    String   @map("customer_id")
  category      String   @map("category") // product_requirement, cooperation_angle, hook
  content       String   @map("content")
  style         String?  @map("style") // professional, casual, aggressive, consultative, friendly
  priority      Int      @default(0) @map("priority")
  source        String   @default("manual") @map("source") // manual, ai_generated
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  @@map("customer_needs")
}

// 客户跟进模型
model FollowUp {
  id                String   @id @default(cuid())
  customerId        String   @map("customer_id")
  contactId         String?  @map("contact_id")
  phone             String?  @map("phone")
  whatsapp          String?  @map("whatsapp")
  email             String?  @map("email")
  followUpMatters   String   @map("follow_up_matters") // 逗号分隔：开发,报价,样品,谈判,成交,其他
  contactMethod     String   @map("contact_method") // 电话,邮件,WhatsApp,微信,其他
  nextAction        String?  @map("next_action")
  priority          String   @default("medium") @map("priority") // high,medium,low
  status            String   @default("in_progress") @map("status") // in_progress,completed,archived
  lastFollowUpDate  DateTime @map("last_follow_up_date")
  nextFollowUpDate  DateTime? @map("next_follow_up_date")
  remarks           String?  @map("remarks")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  
  customer          Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contact           Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  
  @@map("follow_ups")
}

// 跟进话术模型
model FollowUpScript {
  id                String   @id @default(cuid())
  customerId        String   @map("customer_id")
  type              String   @map("type") // whatsapp, email, phone
  title             String   @map("title")
  content           String   @map("content")
  lastSentAt        DateTime? @map("last_sent_at")
  nextFollowUpDate  DateTime? @map("next_follow_up_date")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  customer          Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("follow_up_scripts")
}

// 联系人模型
model Contact {
  id            String   @id @default(cuid())
  customerId    String   @map("customer_id")
  name          String   @map("name") // 姓名
  position      String?  @map("position") // 职位
  email         String?  @map("email") // 邮箱
  whatsapp      String?  @map("whatsapp") // WhatsApp
  phone         String?  @map("phone") // 电话
  remarks       String?  @map("remarks") // 备注信息
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  
  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  keyForCustomers Customer[] @relation("KeyContact") // 被设为关键联系人的客户
  followUps       FollowUp[] // 关联跟进记录
  
  @@map("contacts")
}

// 供应商模型
model Supplier {
  id                String   @id @default(cuid())
  name              String   @map("name") // 公司名称
  email             String?  @unique @map("email")
  phone             String?  @map("phone")
  website           String?  @map("website")
  address           String?  @map("address")
  country           String?  @map("country") // 国家
  mainProducts      String?  @map("main_products") // 主要产品（逗号分隔）
  cooperationStatus String   @default("potential") @map("cooperation_status") // potential, active, suspended, terminated
  riskLevel         String?  @map("risk_level") // high, medium, low
  riskTypes         String?  @map("risk_types") // 逗号分隔：制裁,诉讼,经营异常,合规,其他
  riskDescription   String?  @map("risk_description")
  foundedDate       DateTime? @map("founded_date")
  orderAmount       Decimal? @map("order_amount")
  isStarred         Boolean  @default(false) @map("is_starred")
  notes             String?  @map("notes")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  
  products          Product[]
  files             File[]   @relation("SupplierFiles")
  contacts          SupplierContact[]
  communications    SupplierCommunication[]
  riskEvents        SupplierRiskEvent[]
  
  @@map("suppliers")
}

// 供应商联系人模型
model SupplierContact {
  id                    String   @id @default(cuid())
  supplierId            String   @map("supplier_id")
  name                  String   @map("name")
  position              String?  @map("position")
  phone                 String?  @map("phone")
  whatsapp              String?  @map("whatsapp")
  email                 String?  @map("email")
  wechat                String?  @map("wechat")
  decisionWeight        String?  @map("decision_weight") // 决策权重：关键/重要/一般
  communicationPreference String? @map("communication_preference") // 沟通偏好：wechat, whatsapp, email, phone
  timezone              String?  @map("timezone")
  remarks               String?  @map("remarks")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  
  supplier              Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  communications        SupplierCommunication[]
  
  @@map("supplier_contacts")
}

// 供应商沟通记录模型
model SupplierCommunication {
  id          String   @id @default(cuid())
  supplierId  String   @map("supplier_id")
  contactId   String?  @map("contact_id")
  method      String   @map("method") // phone, email, whatsapp, wechat, meeting, other
  content     String   @map("content")
  createdAt   DateTime @default(now()) @map("created_at")
  
  supplier    Supplier          @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  contact     SupplierContact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  
  @@map("supplier_communications")
}

// 供应商风险事件模型
model SupplierRiskEvent {
  id          String    @id @default(cuid())
  supplierId  String    @map("supplier_id")
  riskType    String    @map("risk_type") // 制裁,诉讼,经营异常,合规,其他
  description String    @map("description")
  severity    String    @default("medium") @map("severity") // high, medium, low
  occurredAt  DateTime  @default(now()) @map("occurred_at")
  resolvedAt  DateTime? @map("resolved_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  
  supplier    Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  
  @@map("supplier_risk_events")
}

// 产品模型
model Product {
  id          String   @id @default(cuid())
  name        String   @map("name")
  sku         String   @unique @map("sku")
  description String?  @map("description")
  price       Decimal  @map("price")
  cost        Decimal? @map("cost")
  stock       Int      @default(0) @map("stock")
  minStock    Int      @default(0) @map("min_stock")
  category    String?  @map("category")
  status      String   @default("active") @map("status")
  supplierId  String?  @map("supplier_id")
  images      String?  @map("images") // 存储 JSON 字符串
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  orderItems  OrderItem[]
  files       File[]    @relation("ProductFiles")
  
  @@map("products")
}

// 订单模型
model Order {
  id          String   @id @default(cuid())
  orderNo     String   @unique @map("order_no")
  customerId  String   @map("customer_id")
  status      String   @default("pending") @map("status")
  totalAmount Decimal  @map("total_amount")
  paidAmount  Decimal  @default(0) @map("paid_amount")
  notes       String?  @map("notes")
  orderDate   DateTime @default(now()) @map("order_date")
  deliveryDate DateTime? @map("delivery_date")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  customer    Customer @relation(fields: [customerId], references: [id])
  items       OrderItem[]
  files       File[]   @relation("OrderFiles")
  
  @@map("orders")
}

// 订单项模型
model OrderItem {
  id          String   @id @default(cuid())
  orderId     String   @map("order_id")
  productId   String   @map("product_id")
  quantity    Int      @map("quantity")
  unitPrice   Decimal  @map("unit_price")
  totalPrice  Decimal  @map("total_price")
  createdAt   DateTime @default(now()) @map("created_at")
  
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])
  
  @@map("order_items")
}

// 文件模型 - 使用可选外键关联到不同实体
model File {
  id            String   @id @default(cuid())
  filename      String   @map("filename")
  originalName  String   @map("original_name")
  filePath      String   @map("file_path")
  fileSize      Int      @map("file_size")
  mimeType      String   @map("mime_type")
  uploadedBy    String?  @map("uploaded_by")
  createdAt     DateTime @default(now()) @map("created_at")
  
  // 可选的外键字段
  customerId    String?  @map("customer_id")
  supplierId    String?  @map("supplier_id")
  orderId       String?  @map("order_id")
  productId     String?  @map("product_id")
  
  // 关系定义
  customer      Customer? @relation("CustomerFiles", fields: [customerId], references: [id], onDelete: Cascade)
  supplier      Supplier? @relation("SupplierFiles", fields: [supplierId], references: [id], onDelete: Cascade)
  order         Order?    @relation("OrderFiles", fields: [orderId], references: [id], onDelete: Cascade)
  product       Product?  @relation("ProductFiles", fields: [productId], references: [id], onDelete: Cascade)
  
  @@map("files")
}

// 用户模型
model User {
  id          String   @id @default(cuid())
  email       String   @unique @map("email")
  name        String?  @map("name")
  password    String   @map("password")
  role        String   @default("user") @map("role")
  description String?  @map("description") // 业务描述：如"专注欧美市场的机械设备外贸业务员"
  company     String?  @map("company") // 公司简介
  contact     String?  @map("contact_info") // 联系方式
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  activities  ActivityLog[]
  customers   Customer[]  // 归属客户
  skills      UserSkill[] // 员工技能
  
  @@map("users")
}

// 活动记录模型（仪表盘统计用）
model ActivityLog {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  customerId  String?  @map("customer_id")
  action      String   @map("action") // customer_added, email_sent, whatsapp_sent, phone_called
  createdAt   DateTime @default(now()) @map("created_at")
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, createdAt])
  @@map("activity_logs")
}

// 员工技能模型
model UserSkill {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  name        String   @map("name") // 技能名称
  category    String   @default("communication") @map("category") // communication, sales, support, technical
  workflow    String   @map("workflow") // 工作流程
  goals       String   @map("goals") // 工作目标
  tips        String?  @map("tips") // 经验技巧
  tools       String?  @map("tools") // 常用工具/平台
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@map("user_skills")
}
